# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=LexIntel AI
APP_ENV=development
DEBUG=true

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=lexintel

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,mp3,wav,mp4,avi,mov,mkv

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── AI — LLM Provider ─────────────────────────────────────────────────────────
# Supported: groq | openai | anthropic | ollama (future)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── AI — LLM Configuration ────────────────────────────────────────────────────
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_STREAMING=true

# ── AI — Embeddings ───────────────────────────────────────────────────────────
# Model is downloaded automatically from HuggingFace on first run
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ── AI — FAISS Vector Store ───────────────────────────────────────────────────
VECTOR_STORE_DIR=./vector_store
VECTOR_STORE_INDEX_NAME=lexintel_index

# ── AI — RAG Pipeline ─────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# ── AI — Conversation Memory ──────────────────────────────────────────────────
MEMORY_MAX_HISTORY=20
MEMORY_COLLECTION=conversations

# ── Phase 3A — Document Intelligence ─────────────────────────────────────────
OCR_ENABLED=true
OCR_LANGUAGE=en
OCR_USE_GPU=false
MAX_PDF_PAGES=50
MIN_TEXT_LENGTH_FOR_OCR=100

# ── Phase 3A — Legal Research RAG ────────────────────────────────────────────
LEGAL_RAG_TOP_K=8
LEGAL_RAG_THRESHOLD=0.35
LEGAL_RESEARCH_INDEX=legal_provisions

# ── Phase 3A — Similar Cases RAG ─────────────────────────────────────────────
CASES_RAG_TOP_K=5
CASES_RAG_THRESHOLD=0.30
CASES_INDEX=case_judgments
