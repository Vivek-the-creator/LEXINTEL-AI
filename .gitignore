# =============================================================================
# LexIntel AI — .gitignore
# =============================================================================

# =============================================================================
# SECRETS & ENVIRONMENT
# =============================================================================
.env
.env.local
.env.*.local
!.env.example

# =============================================================================
# PYTHON — BACKEND
# =============================================================================

# Virtual environments
backend/venv/
backend/.venv/
venv/
.venv/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
.eggs/
wheels/
*.whl
MANIFEST

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml
test-results/

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# =============================================================================
# UPLOADS & RUNTIME DATA
# =============================================================================

# User-uploaded files (never commit real case documents)
backend/uploads/*
!backend/uploads/.gitkeep

# FAISS vector index (rebuilt at runtime)
backend/vector_store/*
!backend/vector_store/.gitkeep

# PaddleOCR model cache
backend/.paddleocr/
.paddleocr/

# Sentence-transformers model cache
backend/.cache/
.cache/

# Temporary analysis files
backend/uploads/tmp_*

# =============================================================================
# NODE — FRONTEND
# =============================================================================

frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================================================================
# OS FILES
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================================================
# EDITORS & IDEs
# =============================================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# =============================================================================
# MISC
# =============================================================================
*.local
*.bak
*.tmp
*.orig
